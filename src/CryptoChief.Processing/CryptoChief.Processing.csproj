<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>CryptoChief.Processing</PackageId>
    <Version>0.8.0</Version>
    <Authors>Crypto Chief</Authors>
    <Company>Crypto Chief</Company>
    <Product>Crypto Chief Processing .NET SDK</Product>
    <Description>Official .NET SDK for the Crypto Chief crypto processing API — a unified crypto payment gateway for accepting crypto payments, sending payouts (single &amp; mass), signing on-chain transactions (incl. EVM/TRON/Solana/TON contract calls without hand-encoded calldata), managing wallets, and verifying webhooks across 25+ blockchains (Ethereum, Tron, TON, Solana, Bitcoin and more).</Description>
    <PackageTags>cryptocurrency;crypto;payments;payouts;stablecoin;usdt;usdc;ethereum;tron;ton;solana;bitcoin;web3;blockchain;evm;abi;erc20;trc20;jetton;anchor;processing-api;payment-gateway</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://crypto-chief.com/processing/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/crypto-chiefs/cryptochief-crypto-processing-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <PackageReleaseNotes>0.8.0 — The platform's outbound webhooks become readable and re-firable: client.Webhooks.InfoAsync reads one delivery with every attempt (HTTP status, duration, the body your endpoint answered), ResendAsync re-fires it, and ResendStaticDepositAsync re-fires the newest webhook of a static deposit by the deposit's uuid — the same routes, bodies and refusal codes as the white-label platform. Every webhook now carries X-Webhook-Delivery (WebhookVerifier.DeliveryHeader), the delivery uuid these methods take and a natural idempotency key; keep it when you log a webhook. New ErrorCodes: DeliverySuperseded (a newer event exists for the same object — only the latest may be resent), DeliveryInFlight, ResendTooSoon, NoDeliveries, NotFound. A resend is synchronous here: Queued=true arrives with Status already delivered or failed.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CryptoChief.Processing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
